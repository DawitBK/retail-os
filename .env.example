# Copy to .env for local development. Never commit a real .env.
DATABASE_URL=postgres://retail:retail@localhost:5432/retail
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
PORT=3000
LOG_LEVEL=info
# How many reverse proxies sit in front of the API (0 when it is reached directly). Only then is X-Forwarded-For believed.
TRUST_PROXY_HOPS=0
