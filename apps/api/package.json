{
  "name": "@retail/api",
  "version": "0.1.0",
  "private": true,
  "description": "Retail OS HTTP API: identity, catalog, parties, inventory, sales, purchases and accounting",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "owner:bootstrap": "node dist/bootstrap-admin.js",
    "seed:demo": "node dist/seed-demo.js"
  },
  "dependencies": {
    "@retail/kit": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
